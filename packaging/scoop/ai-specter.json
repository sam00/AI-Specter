{
  "version": "0.1.0",
  "description": "AI-driven automated penetration testing from your terminal",
  "homepage": "https://sam00.github.io/AI-Specter/",
  "license": "Apache-2.0",
  "depends": "python",
  "suggest": {
    "Python": "python"
  },
  "installer": {
    "script": [
      "python -m pip install --upgrade ai-specter==$version"
    ]
  },
  "uninstaller": {
    "script": [
      "python -m pip uninstall -y ai-specter"
    ]
  },
  "bin": [
    ["python", "specter", "-m specter"]
  ],
  "checkver": {
    "url": "https://pypi.org/pypi/ai-specter/json",
    "jsonpath": "$.info.version"
  },
  "autoupdate": {
    "url": "https://pypi.org/pypi/ai-specter/json"
  }
}
