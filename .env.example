# Specter AI — environment variables. Copy to `.env` or export in your shell.
# Specter AUTO-DETECTS whichever of these are set — none are required for the
# offline demo:  `specter quickstart`.  Check what's detected with `specter doctor`.

# --- Hosted providers -------------------------------------------------------
# Anthropic Claude   (pip install "ai-specter[claude]")
ANTHROPIC_API_KEY=

# OpenAI / GPT       (pip install "ai-specter[openai]")
OPENAI_API_KEY=

# --- Any OpenAI-compatible endpoint -----------------------------------------
# Groq, Together, OpenRouter, vLLM, LM Studio, LiteLLM, Azure OpenAI, etc.
# This is the "use ANY model" path. Set the base URL (plus key/model if the
# endpoint needs them), then route to it explicitly:
#     specter run -t HOST --model openai-compatible:<your-model>
SPECTER_LLM_BASE_URL=
SPECTER_LLM_API_KEY=
SPECTER_LLM_MODEL=
# (OPENAI_BASE_URL / OPENAI_API_BASE / OPENAI_MODEL are also honored.)

# --- Local models via Ollama ------------------------------------------------
# OLLAMA_HOST=http://localhost:11434
